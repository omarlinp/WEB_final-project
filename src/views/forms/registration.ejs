<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">

<div class="container">

    <div class="row justify-content-center align-items-center min-vh-100">

        <div class="col-lg-10">

            <div class="card shadow border-0">

                <div class="row g-0">

                    <!-- Left Panel -->

                    <div class="col-lg-5 bg-dark text-white d-flex flex-column justify-content-center align-items-center p-5">

                        <i class="bi bi-cpu fs-1 mb-4"></i>

                        <h1 class="fw-bold">
                            TechMarket
                        </h1>

                        <p class="text-center mt-3">
                            Create your free account and start buying
                            or selling electronics today.
                        </p>

                    </div>

                    <!-- Registration Form -->

                    <div class="col-lg-7">

                        <div class="p-5">

                            <h2 class="fw-bold">
                                Create Account
                            </h2>

                            <p class="text-secondary mb-4">
                                Fill in the information below.
                            </p>

                            <form>

                                <!-- Name -->

                                <div class="row">

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            First Name
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control"
                                            placeholder="John">

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Last Name
                                        </label>

                                        <input
                                            type="text"
                                            class="form-control"
                                            placeholder="Doe">

                                    </div>

                                </div>


                                <!-- Profile Picture -->

                                <div class="mb-4 text-center">

                                    <label for="profilePicture" class="form-label d-block">
                                        Profile Picture
                                    </label>

                                    <img
                                        id="profilePreview"
                                        src="https://placehold.co/120x120?text=Photo"
                                        class="rounded-circle border mb-3"
                                        style="width:120px;height:120px;object-fit:cover;"
                                        alt="Profile preview">

                                    <input
                                        type="file"
                                        class="form-control"
                                        id="profilePicture"
                                        name="profilePicture"
                                        accept="image/*">

                                </div>

                                <!-- Username -->

                                <div class="mb-3">

                                    <label class="form-label">
                                        Username
                                    </label>

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            @
                                        </span>

                                        <input
                                            type="text"
                                            class="form-control"
                                            placeholder="username">

                                    </div>

                                </div>

                                <!-- Email -->

                                <div class="mb-3">

                                    <label class="form-label">
                                        Email Address
                                    </label>

                                    <input
                                        type="email"
                                        class="form-control"
                                        placeholder="name@example.com">

                                </div>

                                <!-- Password -->

                                <div class="row">

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Password
                                        </label>

                                        <input
                                            type="password"
                                            class="form-control">

                                    </div>

                                    <div class="col-md-6 mb-3">

                                        <label class="form-label">
                                            Confirm Password
                                        </label>

                                        <input
                                            type="password"
                                            class="form-control">

                                    </div>

                                </div>

                                <!-- Terms -->

                                <div class="form-check mb-4">

                                    <input
                                        class="form-check-input"
                                        type="checkbox"
                                        id="terms">

                                    <label
                                        class="form-check-label"
                                        for="terms">

                                        I agree to the
                                        <a href="#">Terms of Service</a>
                                        and
                                        <a href="#">Privacy Policy</a>

                                    </label>

                                </div>

                                <!-- Button -->

                                <button
                                    class="btn btn-dark w-100 mb-3">

                                    Create Account

                                </button>

                                <button
                                    type="button"
                                    class="btn btn-outline-secondary w-100">

                                    <i class="bi bi-google me-2"></i>

                                    Sign up with Google

                                </button>

                            </form>

                            <hr>

                            <p class="text-center mb-0">

                                Already have an account?

                                <a href="/login">
                                    Sign In
                                </a>

                            </p>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>