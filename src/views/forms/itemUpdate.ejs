<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Update Listing</title>
    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/forms/itemUpdate.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h3 class="mb-0"> Update Listing </h3>
                </div>
                <div class="card-body">
                    <form method="POST" enctype="multipart/form-data" id="itemUpdateForm">
                        <input type="hidden" name="id" value="<%= item?.id ?? '' %>">

                        <div class="mb-4">
                            <label for="name" class="form-label fw-semibold"> Item Name </label>
                            <input type="text" class="form-control" id="itemName" name="name" value="<%= item?.name ?? '' %>" placeholder="Example: NVIDIA RTX 4080 Super" required>
                        </div>
                        <div class="mb-4">
                            <label for="price" class="form-label fw-semibold"> Price </label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="price" name="price" min="0" step="0.01" value="<%= item?.price ?? '' %>" placeholder="0.00" required>
                            </div>
                        </div>
                        <div class="mb-4">
                            <label for="description" class="form-label fw-semibold"> Description </label>
                            <textarea class="form-control" id="description" name="description" rows="6" placeholder="Describe the condition, specifications, accessories included, warranty, etc." required><%= item?.description ?? '' %></textarea>
                        </div>
                        <div class="mb-4">
                            <label for="images" class="form-label fw-semibold">Replace Image</label>
                            <input class="form-control" type="file" id="images" name="images" accept="image/*">
                            <div class="form-text"> Leave this blank to keep the current image. </div>
                        </div>

                        <% if (item?.image_path) { %>
                            <div class="mb-4">
                                <p class="form-label fw-semibold mb-2">Current Image</p>
                                <img src="/img/<%= item.image_path %>" alt="<%= item.name %>" class="img-fluid rounded border current-item-image">
                            </div>
                        <% } %>

                        <hr>
                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg">
                                <i class="bi bi-pencil-square me-2"></i>
                                Update Listing
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script src="/js/itemUpdateForm.js"></script>
</body>
</html>