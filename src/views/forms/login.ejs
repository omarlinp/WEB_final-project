<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Sign In</title>

    <link href="/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body class="bg-light">
<div class="container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-lg-10">
            <div class="card shadow border-0">
                <div class="row g-0">
                    <div class="col-lg-6 bg-dark text-white d-flex flex-column justify-content-center align-items-center p-5">
                        <i class="bi bi-cpu fs-1 mb-4"></i>
                        <h1 class="fw-bold"> TechMarket </h1>

                        <p class="text-center mt-3"> Buy and sell electronics safely. Join thousands of users finding great deals every day. </p>
                    </div>
                    <div class="col-lg-6">
                        <div class="p-5">
                            <h2 class="fw-bold mb-1"> Welcome Back </h2>
                            <p class="text-secondary mb-4"> Sign in to your account </p>
                            <form id="login">
                                <div class="mb-3">
                                    <label class="form-label" for="login">Email or Username</label>
                                    <input type="login" class="form-control" placeholder="username on email" name="login">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label"> Password </label>
                                    <input type="password" class="form-control" placeholder="Password" name="password">
                                </div>
                                <div class="d-flex justify-content-between mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" id="remember" name="remember">
                                        <label class="form-check-label" for="remember"> Remember me </label>
                                    </div>
                                    <!-- <a href="#"> Forgot Password? </a> -->
                                </div>
                                <button class="btn btn-dark w-100 mb-3" type="submit"> Sign In </button>
                                <button type="button" class="btn btn-outline-secondary w-100"> <i class="bi bi-google me-2"></i> Continue with Google </button>
                            </form>
                            <hr class="my-4">
                            <p class="text-center mb-0"> Don't have an account?
                                <a href="/users/signup"> Register </a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
<script type="module" src="/js/login.js"></script>
</body>
</html>