<%- include('partials/header') %>
<style>
    .item-img {
        width: 120px;
        height: 120px;
        object-fit: contain;
        object-position: center;
        background-color: #f8f9fa;
    }
</style>
<div class="container py-5">
    <div class="row g-5">
        <div class="col-lg-4">
            <img src="/img/<%= user.profile_image %>" class="img-fluid rounded shadow-sm w-100" alt="Profile Image">
            <div class="d-grid gap-2 mt-3">
                <a href="/users/update?id=<%= user.id %>" class="btn btn-outline-dark">
                    Update Account
                </a>
                <a href="/users/delete?id=<%= user.id %>" class="btn btn-outline-danger">
                    Delete Account
                </a>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="h3 mb-0">Your products</h2>
                <a href="/items/new" class="btn btn-dark">
                    Add item to sell
                </a>
            </div>
            <hr>
            <% items.forEach(item => { %>
            <div class="d-flex mb-4">
                <!-- Added the 'item-img' class here -->
                <img src="/img/<%= item.image_path%>" class="rounded me-3 item-img" alt="<%= item.name%>">
                <div>
                    <h3 class="h4 mb-2"><%= item.name%></h3>
                    <h5 class="text-success mb-2"></h5>
                    <p class="text-secondary mb-0">
                        <%= item.description %>
                    </p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="/items/update?item_id=<%= item.id %>" class="btn btn-outline-dark btn-sm">
                            Update Item
                        </a>
                        <a href="/items/delete?item_id=<%= item.id %>" class="btn btn-outline-danger btn-sm">
                            Delete Item
                        </a>
                    </div>
                </div>
            </div>
            <hr>
            <%});%>
        </div>
    </div>
</div>
<%- include('partials/footer') %>
<script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>