<%- include('partials/header') %>
<div class="container py-5">
<div class="row g-5">
   <div class="col-lg-6">
        <img src="/img/<%= item.image_path%>" class="img-fluid rounded shadow-sm mb-3">
    </div>
    <!-- Details -->

    <div class="col-lg-6">
        <h1 class="fw-bold"> <%= item.name%> </h1>
        <h2 class="text-success mb-4"><%= item.price%>  </h2>
        <table class="table">
            <tbody>
                <tr>
                    <th>Seller</th>
                    <td><%= user.first_name %> <%= user.last_name %></td>
                </tr>

                <tr>
                    <th>Email</th>
                    <td><%= user.email %></td>
                </tr>

                <tr>
                    <th>Phone</th>
                    <td><%= user.phone %></td>
                </tr>

                <tr>
                    <th>Posted</th>
                    <td><%= item.created_date%></td>
                </tr>

            </tbody>

        </table>

    </div>

</div>

<!-- Description -->

<div class="card mt-5">

    <div class="card-header fw-bold">
        Description
    </div>

    <div class="card-body">

        <p><%= item.description %></p>

    </div>

</div>
<%- include('partials/footer') %>

</body>
</html>